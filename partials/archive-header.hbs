<section class="archive-header">
    <div class="section-label">{{label}}</div>

    <div class="archive-meta-panel">
        {{#if meta_1}}<div>{{meta_1}}</div>{{/if}}
        {{#if meta_2}}<div>{{meta_2}}</div>{{/if}}
        {{#if meta_3}}<div>{{meta_3}}</div>{{/if}}
    </div>

    <h1 class="archive-title">{{title}}</h1>

    {{#if description}}
        <p class="archive-description">{{description}}</p>
    {{/if}}
</section>