{{#if isSecondary}}
    {{navigation type="secondary"}}
{{else}}
    <ul class="nav-list">
        {{#foreach navigation}}
            <li class="nav-item nav-{{slug}}{{#if current}} nav-current{{/if}}">
                <a href="{{url absolute="true"}}">{{label}}</a>
            </li>
        {{/foreach}}
    </ul>
{{/if}}