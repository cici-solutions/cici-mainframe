<footer class="post-footer">
    {{#if tags}}
        <div class="post-tags">
            TAGS:
            {{#foreach tags}}
                <a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}
            {{/foreach}}
        </div>
    {{/if}}

    <div class="post-archive-link">
        <a href="/">back to archive</a>
    </div>
</footer>