<div class="post-meta-panel">
    <div>FILE: {{slug}}.txt</div>
    <div>ENTRY ID: {{id}}</div>
    <div>PUBLISHED: {{date format="YYYY-MM-DD"}}</div>
    {{#primary_tag}}
    <div>CATEGORY: <a href="{{url}}">{{name}}</a></div>
    {{/primary_tag}}
    <div>READING TIME: {{reading_time}}</div>
    {{#primary_author}}
    <div>AUTHOR: <a href="{{url}}">{{name}}</a></div>
    {{/primary_author}}
</div>
