{{!< default}}

{{#post}}
<article class="post-view">
    <div class="container">
        <header class="post-header">
            {{> "post-meta"}}

            <h1 class="post-title">{{title}}</h1>

            {{#if excerpt}}
                <p class="post-excerpt">{{excerpt}}</p>
            {{/if}}
        </header>

        <section class="post-content gh-content">
            {{content}}
        </section>

        {{> "article-footer"}}
        {{> "prev-next"}}
    </div>
</article>
{{/post}}