{{!< default}} {{#author}}
<div class="container">
    <section class="archive-header">
        <div class="section-label">AUTHOR NODE</div>

        <div class="archive-meta-panel">
            <div>AUTHOR: {{name}}</div>
            <div>STATUS: ACTIVE</div>
            {{#if bio}}
            <div>BIO: {{bio}}</div>
            {{/if}}
        </div>

        <h1 class="archive-title">{{name}}</h1>

        {{#if bio}}
        <p class="archive-description">{{bio}}</p>
        {{else}}
        <p class="archive-description">Published entries by this author node.</p>
        {{/if}}
    </section>
</div>
{{/author}}

<div class="container">
    <section class="entry-list-section">
        <div class="section-label section-label--muted">ENTRIES</div>

        <div class="entry-list">
            {{#foreach posts}} {{> "entry-row"}} {{else}} {{> "empty-state" message="No entries found for this
            author."}} {{/foreach}}
        </div>

        {{pagination}}
    </section>
</div>
