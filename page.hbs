{{!< default}}

{{#post}}
<article class="page-view">
    <div class="container">
        <header class="post-header">
            <div class="post-meta-panel">
                <div>FILE: {{slug}}.txt</div>
                <div>TYPE: PAGE</div>
                <div>PUBLISHED: {{date format="YYYY-MM-DD"}}</div>
            </div>

            {{#match @page.show_title_and_feature_image}}
                <h1 class="post-title">{{title}}</h1>

                {{#if feature_image}}
                    <figure class="post-feature-image">
                        <img
                            srcset="
                                {{img_url feature_image size="s"}} 300w,
                                {{img_url feature_image size="m"}} 600w,
                                {{img_url feature_image size="l"}} 1000w,
                                {{img_url feature_image size="xl"}} 1600w,
                                {{img_url feature_image size="xxl"}} 2000w
                            "
                            sizes="(max-width: 768px) 100vw, (max-width: 1200px) min(100vw - 2rem, 1120px), 1000px"
                            src="{{img_url feature_image size="l"}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                            loading="eager"
                            decoding="async"
                        >
                        {{#if feature_image_caption}}
                            <figcaption>{{feature_image_caption}}</figcaption>
                        {{/if}}
                    </figure>
                {{/if}}
            {{/match}}
        </header>

        <section class="post-content gh-content">
            {{content}}
        </section>
    </div>
</article>
{{/post}}