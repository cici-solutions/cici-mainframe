{{!< default}} {{#tag}}
<div class="container">
    <section class="archive-header">
        <div class="section-label">TAG ARCHIVE</div>

        <div class="tag-meta-panel">
            <div>TAG: {{name}}</div>
            <div>STATUS: ACTIVE</div>
            {{#if description}}
            <div>DESCRIPTION: {{description}}</div>
            {{/if}}
        </div>

        <h1 class="tag-title">{{name}}</h1>

        {{#if description}}
        <p class="tag-description">{{description}}</p>
        {{/if}}
    </section>
</div>
{{/tag}}

<div class="container">
    <section class="entry-list-section">
        <div class="section-label section-label--muted">ENTRIES</div>

        <div class="entry-list">
            {{#foreach posts}} {{> "entry-row"}} {{else}} {{> "empty-state" message="No entries found for this tag."}}
            {{/foreach}}
        </div>

        {{pagination}}
    </section>
</div>
