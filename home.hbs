{{!< default}}

<div class="container">
    {{> "system-intro"}}

    {{#get "posts" filter="featured:true" limit="4" include="tags,authors"}}
        {{#if posts}}
            <section class="featured-entries-section">
                <div class="section-label">FEATURED ENTRIES</div>

                <div class="featured-entries-list">
                    {{#foreach posts}}
                        {{> "featured-entry" label="FEATURED ENTRY"}}
                    {{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}

    <section class="entry-list-section">
        <div class="section-label section-label--muted">LATEST ENTRIES</div>

        <div class="entry-list">
            {{#foreach posts}}
                {{> "entry-row"}}
            {{else}}
                {{> "empty-state" message="No published entries found in this node."}}
            {{/foreach}}
        </div>

        <div class="archive-utility-row">
            <a href="/archive/">archives →</a>
        </div>

        {{pagination}}
    </section>
</div>