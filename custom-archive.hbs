{{!< default}}

{{#post}}
<article class="page-view page-view--archive">
    <div class="container">
        <header class="post-header">
            <div class="post-meta-panel">
                <div>FILE: archive.txt</div>
                <div>TYPE: SYSTEM PAGE</div>
                <div>NODE: PUBLIC ARCHIVE</div>
            </div>

            <h1 class="post-title">{{title}}</h1>

            {{#if excerpt}}
                <p class="post-excerpt">{{excerpt}}</p>
            {{else}}
                <p class="post-excerpt">
                    Complete record of published entries across engineering, operations, product, and strategy.
                </p>
            {{/if}}
        </header>

        <section class="post-content gh-content">
            {{content}}
        </section>

        {{#get "posts" limit="20" include="tags,authors"}}
            <section class="entry-list-section">
                <div class="section-label section-label--muted">ALL ENTRIES</div>

                <div class="entry-list">
                    {{#foreach posts}}
                        {{> "entry-row"}}
                    {{else}}
                        {{> "empty-state" message="No entries available in the archive."}}
                    {{/foreach}}
                </div>
            </section>
        {{/get}}
    </div>
</article>
{{/post}}