{{!< default}}

{{#post}}
<article class="page-view page-view--archive">
    <div class="container container--narrow">
        <header class="post-header">
            <div class="post-meta-panel">
                <div>FILE: archive.txt</div>
                <div>TYPE: SYSTEM PAGE</div>
                <div>NODE: PUBLIC ARCHIVE</div>
            </div>

            <h1 class="post-title">{{title}}</h1>

            {{#if excerpt}}
                <p class="post-excerpt">{{excerpt}}</p>
            {{else}}
                <p class="post-excerpt">
                    Browse the complete publishing log and explore entries by topic, date, and author.
                </p>
            {{/if}}
        </header>

        <section class="post-content gh-content">
            {{content}}
        </section>

        <footer class="post-footer">
            <div class="post-archive-link">
                <a href="/">view latest entries →</a>
            </div>
        </footer>
    </div>
</article>
{{/post}}